# Copy to .env (`make .env` does it for you) and edit there. .env is gitignored.
# Plain KEY=value lines, no quotes: both make and uv read this file.

# --- Google Cloud / Vertex AI ---
VERTEXAI_PROJECT=nyc-lease-lens
VERTEXAI_LOCATION=global

# --- Model (any LiteLLM model string) ---
MODEL=vertex_ai/gemini-3.5-flash-lite

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- uv (slow or flaky networks) ---
UV_HTTP_TIMEOUT=300
UV_CONCURRENT_DOWNLOADS=4

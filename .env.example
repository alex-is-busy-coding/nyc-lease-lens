# Copy to .env (`make env` does it for you) and edit there.
# Environment variables override values in this file. Unset keys use the defaults in
# src/nyc_lease_lens/config.py.

# Google Cloud / Vertex AI
VERTEXAI_PROJECT=nyc-lease-lens
VERTEXAI_LOCATION=global

# Model
MODEL=vertex_ai/gemini-3.5-flash-lite
MAX_TOOL_ROUNDS=8

# Server
HOST=127.0.0.1
PORT=8000

# Logging: DEBUG adds chat messages, tool arguments and every Open Data request.
# Use LOG_FORMAT=json for log collectors such as Cloud Logging.
LOG_LEVEL=INFO
LOG_FORMAT=text

# NYC Open Data
OPENDATA_TIMEOUT=20
OPENDATA_RETRIES=2

# uv
UV_HTTP_TIMEOUT=300
UV_CONCURRENT_DOWNLOADS=4

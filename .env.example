# Copy to .env (`make env` does it for you) and edit there.
# Environment variables override values in this file. Unset keys use the defaults in
# src/nyc_lease_lens/config.py, grouped the same way as below.

# LLM (LLMSettings)
MODEL=vertex_ai/gemini-3.5-flash-lite
VERTEXAI_PROJECT=nyc-lease-lens
VERTEXAI_LOCATION=global
MAX_TOOL_ROUNDS=8

# Server (ServerSettings)
HOST=127.0.0.1
PORT=8000

# NYC Open Data (OpenDataSettings)
OPENDATA_TIMEOUT=20
OPENDATA_RETRIES=2
# Requests slower than this (milliseconds) are logged as warnings.
OPENDATA_SLOW_MS=5000

# Logging (LoggingSettings): DEBUG adds chat messages, tool arguments and every Open Data request.
# Use LOG_FORMAT=json for log collectors such as Cloud Logging.
LOG_LEVEL=INFO
LOG_FORMAT=text

# uv (read by uv, not the app)
UV_HTTP_TIMEOUT=300
UV_CONCURRENT_DOWNLOADS=4
